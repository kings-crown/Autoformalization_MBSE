{
  "metadata": {
    "requirementSetId": "door-controller",
    "title": "Door Access Controller",
    "system": "Door access control module for a secure entry point",
    "requirements": [
      {
        "id": "FR1",
        "text": "When the door is closed, the controller shall eventually engage the lock."
      },
      {
        "id": "FR2",
        "text": "The lock shall never be engaged while the door is detected as open."
      },
      {
        "id": "FR3",
        "text": "If the user presents a valid credential while the door is closed, the controller shall unlock the door within one cycle."
      }
    ],
    "assumptions": [
      "Sensors accurately report whether the door is OPEN or CLOSED."
    ]
  },
  "signature": {
    "sorts": [
      {
        "name": "DoorState",
        "kind": "enum",
        "values": [
          "OPEN",
          "CLOSED"
        ]
      }
    ],
    "constants": [
      {
        "name": "credential_presented",
        "sort": "Bool",
        "description": "Whether a valid credential was presented in the current cycle."
      },
      {
        "name": "door_state",
        "sort": "DoorState",
        "description": "Current observed door position."
      },
      {
        "name": "lock_engaged",
        "sort": "Bool",
        "description": "Whether the lock is currently engaged."
      }
    ],
    "functions": [
      {
        "name": "next_lock_engaged",
        "domain": [
          "DoorState",
          "Bool",
          "Bool"
        ],
        "codomain": "Bool",
        "description": "Lock engagement in the next controller cycle."
      }
    ],
    "predicates": []
  },
  "axioms": [
    {
      "id": "axiom_fr1",
      "requirementIds": [
        "FR1"
      ],
      "description": "If the door is closed the controller drives the lock engaged in the next cycle.",
      "formula": {
        "kind": "forall",
        "quantifiers": [
          {
            "symbol": "state",
            "sort": "DoorState"
          },
          {
            "symbol": "locked",
            "sort": "Bool"
          },
          {
            "symbol": "cred",
            "sort": "Bool"
          }
        ],
        "body": {
          "kind": "implies",
          "antecedent": {
            "kind": "and",
            "operands": [
              {
                "kind": "eq",
                "left": {
                  "kind": "identifier",
                  "name": "state"
                },
                "right": {
                  "kind": "identifier",
                  "name": "CLOSED"
                }
              },
              {
                "kind": "eq",
                "left": {
                  "kind": "identifier",
                  "name": "locked"
                },
                "right": {
                  "kind": "bool",
                  "value": false
                }
              }
            ]
          },
          "consequent": {
            "kind": "eq",
            "left": {
              "kind": "apply",
              "name": "next_lock_engaged",
              "args": [
                {
                  "kind": "identifier",
                  "name": "state"
                },
                {
                  "kind": "identifier",
                  "name": "locked"
                },
                {
                  "kind": "identifier",
                  "name": "cred"
                }
              ]
            },
            "right": {
              "kind": "bool",
              "value": true
            }
          }
        }
      }
    },
    {
      "id": "axiom_fr2",
      "requirementIds": [
        "FR2"
      ],
      "description": "The lock cannot be engaged when the door is open.",
      "formula": {
        "kind": "implies",
        "antecedent": {
          "kind": "eq",
          "left": {
            "kind": "identifier",
            "name": "door_state"
          },
          "right": {
            "kind": "identifier",
            "name": "OPEN"
          }
        },
        "consequent": {
          "kind": "eq",
          "left": {
            "kind": "identifier",
            "name": "lock_engaged"
          },
          "right": {
            "kind": "bool",
            "value": false
          }
        }
      }
    },
    {
      "id": "axiom_fr3",
      "requirementIds": [
        "FR3"
      ],
      "description": "A valid credential while closed causes the lock to disengage next cycle.",
      "formula": {
        "kind": "forall",
        "quantifiers": [
          {
            "symbol": "state",
            "sort": "DoorState"
          },
          {
            "symbol": "locked",
            "sort": "Bool"
          }
        ],
        "body": {
          "kind": "implies",
          "antecedent": {
            "kind": "and",
            "operands": [
              {
                "kind": "eq",
                "left": {
                  "kind": "identifier",
                  "name": "state"
                },
                "right": {
                  "kind": "identifier",
                  "name": "CLOSED"
                }
              },
              {
                "kind": "identifier",
                "name": "credential_presented"
              }
            ]
          },
          "consequent": {
            "kind": "eq",
            "left": {
              "kind": "apply",
              "name": "next_lock_engaged",
              "args": [
                {
                  "kind": "identifier",
                  "name": "state"
                },
                {
                  "kind": "identifier",
                  "name": "locked"
                },
                {
                  "kind": "bool",
                  "value": true
                }
              ]
            },
            "right": {
              "kind": "bool",
              "value": false
            }
          }
        }
      }
    }
  ]
}